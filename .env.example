# Porchlight configuration. Copy to .env and edit; every variable is optional.
# Settings live in porchlight/config.py (pydantic-settings, prefix PORCHLIGHT_).

# --- wiring -------------------------------------------------------------------
# demo = local sqlite + simulated channel; live = configured store + real channel
PORCHLIGHT_MODE=demo
# bedrock = real Claude models on Amazon Bedrock; mock = scripted MockModel, no AWS
PORCHLIGHT_MODEL_PROVIDER=mock
# sqlite = local file/in-memory; dynamo = single-table DynamoDB
PORCHLIGHT_STORE=sqlite
# local = tools imported in-process; mcp = tools consumed from the MCP server
PORCHLIGHT_TOOLS=local
# memory = /api/events streams this process's own trace; store = tail the persisted trace
# (use "store" when the API runs on Lambda and the agents run on AgentCore Runtime)
PORCHLIGHT_EVENTS_SOURCE=memory

# --- local persistence --------------------------------------------------------
# SQLite database file (":memory:" is allowed)
PORCHLIGHT_SQLITE_PATH=data/local/porchlight.db
# Where FileSessionManager keeps graph sessions and persisted interrupts
PORCHLIGHT_SESSION_DIR=data/sessions

# --- AWS ----------------------------------------------------------------------
# S3 bucket for S3SessionManager; unset to use the local file session manager
# PORCHLIGHT_SESSION_BUCKET=porchlight-sessions
# AgentCore Memory id; unset to use the local SQLite memory store
# PORCHLIGHT_MEMORY_ID=porchlight-memory-abc123
# DynamoDB single-table name (used when PORCHLIGHT_STORE=dynamo)
PORCHLIGHT_DYNAMO_TABLE=porchlight
# Region; falls back to AWS_REGION then AWS_DEFAULT_REGION
PORCHLIGHT_AWS_REGION=us-west-2
# AgentCore Runtime ARN; when set, the API calls the runtime instead of running in-process
# PORCHLIGHT_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/porchlight

# --- messaging ----------------------------------------------------------------
# Verified SES sender address used by EmailChannel when PORCHLIGHT_MODE=live. Left at this
# placeholder, live mode logs every message instead of sending it — SES rejects an unverified
# sender, and a deploy whose messages all silently fail is worse than one that logs them.
PORCHLIGHT_FROM_ADDR=porchlight@example.org

# --- models -------------------------------------------------------------------
PORCHLIGHT_MODEL_SONNET=global.anthropic.claude-sonnet-4-6
PORCHLIGHT_MODEL_HAIKU=global.anthropic.claude-haiku-4-5-20251001-v1:0

# --- group policy -------------------------------------------------------------
PORCHLIGHT_GROUP_NAME=Maple Street Mutual Aid
PORCHLIGHT_TIMEZONE=America/Toronto
# Local hours during which Porchlight will not send messages (JSON array: [start, end])
PORCHLIGHT_QUIET_HOURS=[21, 8]
# Any commitment above this dollar amount needs a Decision Card
PORCHLIGHT_PETTY_CASH_LIMIT=40.0
# How many volunteers to ask before escalating to the coordinator
PORCHLIGHT_MAX_CANDIDATES=3
# Escalate when this many hours remain before the request window and nobody has accepted
PORCHLIGHT_ESCALATE_HOURS_BEFORE_WINDOW=6
# Matcher confidence below this raises a Decision Card instead of acting
PORCHLIGHT_CONFIDENCE_THRESHOLD=0.55
