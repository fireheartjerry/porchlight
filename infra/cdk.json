{
  "app": "npx ts-node --prefer-ts-exts bin/porchlight.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "output": "cdk.out",
  "context": {
    "stackName": "PorchlightAppStack",
    "tableName": "porchlight",
    "runtimeArn": "",
    "memoryId": "",
    "fromAddr": "",
    "account": "",
    "region": "",
    "lambdaBundle": "../build/lambda",
    "webDist": "../web/dist",
    "lwaLayerVersion": "28",
    "lwaLayerAccount": "753240598075",
    "apiMemoryMb": "1536",
    "sweepMemoryMb": "1024",
    "sweepRateMinutes": "60",
    "briefCron": "cron(0 6 * * ? *)",
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ]
  }
}
